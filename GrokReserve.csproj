<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>GrokReserve</AssemblyName>
    <RootNamespace>GrokReserve</RootNamespace>
    <Product>Grok Reserve</Product>
    <AssemblyTitle>Grok Reserve</AssemblyTitle>
    <Version>1.0.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\grok.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\grok.png" />
    <EmbeddedResource Include="Assets\grok.ico" />
  </ItemGroup>
</Project>
